# Environment variables template for AI Sales SaaS (Vendedor IA)
# Never commit real secrets to this file or the repository.

# Server Configuration
PORT=3000
NODE_ENV=development

# BLK-020 Authentication
# Strong server-side secret (minimum 32 chars). Never expose as VITE_*.
SESSION_SECRET=
# Firebase project identifier used by firebase-admin token verification.
FIREBASE_PROJECT_ID=
# Public Firebase web app configuration (not credentials/secrets).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# AI Provider Credentials (Server-Side Only - when approved in future blocks)
GEMINI_API_KEY=

# Database / Storage (when approved in future blocks)
# DATABASE_URL=

# Channel Integrations (when approved in future blocks)
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# Payment Integrations (when approved in future blocks)
# MERCADO_PAGO_ACCESS_TOKEN=
# PAGBANK_TOKEN=
