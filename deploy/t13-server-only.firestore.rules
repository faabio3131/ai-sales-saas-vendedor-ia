rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Backend-only data: access through authenticated API + Firebase Admin SDK.
    // An authenticated Firebase client is NOT an authorized financial writer.
    // This deny-all baseline also covers any new collection by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
