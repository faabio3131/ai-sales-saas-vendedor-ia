# Firebase Web/PWA client configuration.
# These values identify the Firebase Web app and must be injected by the deployment environment.
# Do not hardcode environment-specific values in application source.
VITE_FIREBASE_API_KEY=replace-with-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=ai-sales-saas-vendedor-ia-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ai-sales-saas-vendedor-ia-prod
VITE_FIREBASE_APP_ID=replace-with-firebase-web-app-id
