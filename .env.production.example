NODE_ENV=production
PORT=3000
SESSION_SECRET=replace-with-secret-manager-value-min-32-chars
FIREBASE_PROJECT_ID=replace-with-real-project-id
PUBLIC_APP_URL=https://replace-with-production-domain

# Configure real AI provider in secret manager; at least one approved provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Configure together when WhatsApp real traffic is enabled.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Commercial release gates.
PAYMENT_PROVIDER_API_KEY=
COMMERCIAL_BILLING_ENABLED=false
PRODUCTION_MONITORING_ENABLED=false
LEGAL_DOCS_APPROVED=false
ROLLBACK_PLAN_APPROVED=false
PILOT_VALIDATED=false

# Optional internal T01 cognitive service (never expose port publicly).
# Store the secret in your secret manager; do not commit real credentials.
COGNITIVE_SERVICE_URL=
COGNITIVE_S2S_SECRET=
# Preserve Gemini as primary model until the cognitive-first path is approved.
COGNITIVE_ROUTE_PRIORITY=GEMINI_FIRST
COGNITIVE_METERING_ENABLED=false
